ifeq "$(CFG)" "release"

GCC_ExtraCompilerFlags=
GCC_ExtraCxxCompilerFlags=
GCC_ExtraLinkerFlags=
DisableLinkerDeadCodeElimination=
SymbolVisibility=hidden
TreatWarningsAsErrors=false
OptimizerLevel=-gdwarf-4 -g2 $(OptimizerLevel_CompilerSpecific)
PrecompiledHeaderInclude=
SystemLibraries=
DLL_EXT=_client.so
SYM_EXT=.dbg
DEVTOOLS := ../../../devtools
MAKEFILE_BASE := $(DEVTOOLS)/makefile_base_posix.mak
COMPILE_DEPENDANT_MAKEFILES := vaudio_speex_linux64.mak $(MAKEFILE_BASE)
FORCEINCLUDES= 
DEFINES += -DVPC -DCSTRIKE_REL_BUILD=1 -DNO_STEAM=1 -DNDEBUG -DGNUC -DPOSIX -DCOMPILER_GCC -DMEMOVERRIDE_MODULE=vaudio_speex -D_DLL_EXT=_client.so -D_LINUX -DLINUX -DPOSIX -D_POSIX -DDLLNAME=vaudio_speex -DGL_GLEXT_PROTOTYPES -DDX_TO_GL_ABSTRACTION -DUSE_SDL -DCSTRIKE15 -DSPEEX_EXPORTS -D_DLL_EXT=_client.so -D_DLL_PREFIX=lib -D_EXTERNAL_DLL_EXT=.so -D_LINUX=1 -D_LINUXSTEAMRT64=1 -D_POSIX=1 -DLINUX=1 -DLINUX64=1 -DLINUXSTEAMRT64=1 -DPOSIX=1 -DPROJECTDIR=/home/decaloverdose/Projects/srcmodbase-source/engine/voice_codecs/speex -DVPCGAME=csgo -DVPCGAMECAPS=CSGO 
INCLUDEDIRS += ../../../common ../../../public ../../../public/tier0 ../../../public/tier1 ../../../thirdparty/SDL2 ../frame_encoder ../../../public ../../../public/tier1 ../.. ../../../common ./source/libspeex ../../audio/public 
CONFTYPE=dll
IMPORTLIBRARY=../../../build/lib/linuxsteamrt64/vaudio_speex_client.a
OUTPUTFILE=$(OBJ_DIR)/vaudio_speex_client.so
GAMEOUTPUTFILE=../../../../game/bin/linuxsteamrt64/linuxsteamrt64/vaudio_speex_client.so

CPPFILES= \
    ../../../public/tier0/memoverride.cpp \
    ../../../tier1/interface.cpp \
    ../frame_encoder/voice_codec_frame.cpp \
    VoiceEncoder_Speex.cpp \
    source/libspeex/nb_celp.c \
    source/libspeex/sb_celp.c \
    source/libspeex/lpc.c \
    source/libspeex/ltp.c \
    source/libspeex/lsp.c \
    source/libspeex/quant_lsp.c \
    source/libspeex/lsp_tables_nb.c \
    source/libspeex/gain_table.c \
    source/libspeex/gain_table_lbr.c \
    source/libspeex/cb_search.c \
    source/libspeex/filters.c \
    source/libspeex/bits.c \
    source/libspeex/modes.c \
    source/libspeex/vq.c \
    source/libspeex/high_lsp_tables.c \
    source/libspeex/vbr.c \
    source/libspeex/hexc_table.c \
    source/libspeex/exc_5_256_table.c \
    source/libspeex/exc_5_64_table.c \
    source/libspeex/exc_8_128_table.c \
    source/libspeex/exc_10_32_table.c \
    source/libspeex/exc_10_16_table.c \
    source/libspeex/exc_20_32_table.c \
    source/libspeex/hexc_10_32_table.c \
