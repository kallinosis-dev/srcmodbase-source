include $(wildcard $(OBJ_DIR)/ltp.P)
include $(wildcard $(OBJ_DIR)/lsp.P)
include $(wildcard $(OBJ_DIR)/quant_lsp.P)
include $(wildcard $(OBJ_DIR)/lsp_tables_nb.P)
include $(wildcard $(OBJ_DIR)/gain_table.P)
include $(wildcard $(OBJ_DIR)/gain_table_lbr.P)
include $(wildcard $(OBJ_DIR)/cb_search.P)
include $(wildcard $(OBJ_DIR)/filters.P)
include $(wildcard $(OBJ_DIR)/bits.P)
include $(wildcard $(OBJ_DIR)/modes.P)
include $(wildcard $(OBJ_DIR)/vq.P)
include $(wildcard $(OBJ_DIR)/high_lsp_tables.P)
include $(wildcard $(OBJ_DIR)/vbr.P)
include $(wildcard $(OBJ_DIR)/hexc_table.P)
include $(wildcard $(OBJ_DIR)/exc_5_256_table.P)
include $(wildcard $(OBJ_DIR)/exc_5_64_table.P)
include $(wildcard $(OBJ_DIR)/exc_8_128_table.P)
include $(wildcard $(OBJ_DIR)/exc_10_32_table.P)
include $(wildcard $(OBJ_DIR)/exc_10_16_table.P)
include $(wildcard $(OBJ_DIR)/exc_20_32_table.P)
