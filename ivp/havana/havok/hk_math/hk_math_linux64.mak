include $(wildcard $(OBJ_DIR)/incr_lu.P)
include $(wildcard $(OBJ_DIR)/gauss_elimination.P)
include $(wildcard $(OBJ_DIR)/quaternion.P)
include $(wildcard $(OBJ_DIR)/quaternion_util.P)
include $(wildcard $(OBJ_DIR)/vector3.P)
include $(wildcard $(OBJ_DIR)/vector3_util.P)
include $(wildcard $(OBJ_DIR)/densematrix.P)
include $(wildcard $(OBJ_DIR)/densematrix_util.P)
include $(wildcard $(OBJ_DIR)/eulerangles.P)
